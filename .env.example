# Copy to .env.local. Never commit real credentials.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
# Enable on Azure App Service behind its trusted reverse proxy.
# AUTH_TRUST_HOST=true

# Azure SQL: passwordless DefaultAzureCredential (az login locally,
# App Service managed identity on Azure). Create schema before using history.
SQL_SERVER=
SQL_DATABASE=
# Only for a user-assigned managed identity; leave empty for system-assigned.
SQL_MANAGED_IDENTITY_CLIENT_ID=

# Server-only shared connector credential. Generate at least 32 random characters.
# Use the same token in Azure App Service and the trusted local connector, never the browser.
AI_CONNECTOR_TOKEN=
# Local connector process only (not needed in App Service):
# AI_PORTAL_URL=https://your-app.azurewebsites.net
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LM_STUDIO_MODEL=your-loaded-model-id
# LM_STUDIO_API_KEY=optional-lm-studio-api-token
